---
// "Coming up soon" body for pages whose content is not ready yet.
interface Props {
  note?: string;
}
const { note } = Astro.props;
---

<div class="bg-[#EEEEFF] border-l-4 border-[#FFBE78] p-8 max-w-3xl">
  <p class="text-2xl font-light text-[#00008C]">Coming up soon</p>
  {note && <p class="mt-3 text-[#171717]">{note}</p>}
  <slot />
  <p class="mt-4 text-sm text-[#66668F]">
    Questions? Write to <a href="mailto:netsci@tu-dresden.de" class="underline text-[#00008C]">netsci@tu-dresden.de</a>.
  </p>
</div>
