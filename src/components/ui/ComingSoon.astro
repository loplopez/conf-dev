---
// "Coming up soon" body for pages whose content is not ready yet.
interface Props {
  note?: string;
}
const { note } = Astro.props;
---

<div class="bg-[#E8F1FB] border-l-4 border-[#C9A24B] p-8 max-w-3xl">
  <p class="text-2xl font-light text-[#003063]">Coming up soon</p>
  {note && <p class="mt-3 text-[#171717]">{note}</p>}
  <slot />
  <p class="mt-4 text-sm text-[#5B6B7F]">
    Questions? Write to <a href="mailto:netsci@tu-dresden.de" class="underline text-[#003063]">netsci@tu-dresden.de</a>.
  </p>
</div>
