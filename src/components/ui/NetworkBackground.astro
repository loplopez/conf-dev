---
/**
 * NetworkBackground — decorative network drawn behind white sections.
 * A seeded random geometric graph (same picture on every build): nodes connect to
 * neighbours within a radius; a few hubs in gold. Purely decorative (aria-hidden).
 */
interface Props {
  seed?: number;
  nodes?: number;
  width?: number;
  height?: number;
}
const { seed = 2027, nodes = 140, width = 1400, height = 1000 } = Astro.props;

// mulberry32 PRNG — deterministic output for a given seed
function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const pts = Array.from({ length: nodes }, () => ({ x: r() * width, y: r() * height }));
const radius = 150;
const edges: [number, number, number][] = [];
const degree = new Array(nodes).fill(0);
for (let i = 0; i < nodes; i++) {
  for (let j = i + 1; j < nodes; j++) {
    const d = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
    if (d < radius) { edges.push([i, j, d]); degree[i]++; degree[j]++; }
  }
}
const hubCut = [...degree].sort((a, b) => b - a)[Math.floor(nodes * 0.06)];
---

<svg
  class="absolute inset-0 w-full h-full pointer-events-none select-none"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  style="mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 30%, rgba(0,0,0,0.35) 75%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 30%, rgba(0,0,0,0.35) 75%, transparent 100%);"
>
  <g stroke="#003063" stroke-linecap="round">
    {edges.map(([i, j, d]) => (
      <line x1={pts[i].x} y1={pts[i].y} x2={pts[j].x} y2={pts[j].y}
        stroke-width={degree[i] >= hubCut || degree[j] >= hubCut ? 1.1 : 0.7}
        stroke-opacity={(0.16 * (1 - d / radius) + 0.03).toFixed(3)} />
    ))}
  </g>
  <g>
    {pts.map((p, i) => degree[i] >= hubCut ? (
      <circle cx={p.x} cy={p.y} r={5} fill="#C9A24B" fill-opacity="0.55" />
    ) : (
      <circle cx={p.x} cy={p.y} r={1.6 + Math.min(degree[i], 8) * 0.35} fill="#003063" fill-opacity="0.18" />
    ))}
  </g>
</svg>
