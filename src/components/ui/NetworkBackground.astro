---
/** Canvas for the floating-network animation (see src/scripts/networks.ts). Decorative. */
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: cls = '' } = Astro.props;
---

<canvas data-network={variant} class={`absolute inset-0 w-full h-full pointer-events-none ${cls}`} aria-hidden="true"></canvas>
