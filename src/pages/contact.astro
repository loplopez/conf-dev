---
import PageLayout from '../layouts/PageLayout.astro';

// Mailboxes confirmed by the organising committee (2 Oct 2026).
const contacts = [
  { email: 'netsci@tu-dresden.de', topic: 'General enquiries', desc: 'Everything about NetSci 2027 not covered below: registration, venue, travel, partners and sponsors.' },
  { email: 'program.netsci@tu-dresden.de', topic: 'Program', desc: 'Questions about the scientific program, abstracts, talks and posters.' },
  { email: 'satellites.netsci@tu-dresden.de', topic: 'Satellites', desc: 'Satellite proposals and questions about satellite symposia.' },
];
---

<PageLayout title="Contact" crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}>
  <div class="grid md:grid-cols-3 gap-5">
    {contacts.map((c) => (
      <div class="shadow-card p-6">
        <h2 class="text-xl">{c.topic}</h2>
        <a href={`mailto:${c.email}`} class="mt-2 inline-block text-[#003063] underline hover:text-[#C9A24B] break-all">{c.email}</a>
        <p class="mt-3 text-sm text-[#171717]">{c.desc}</p>
      </div>
    ))}
  </div>
  <p class="mt-8 text-sm text-[#5B6B7F]">
    NetSci 2027 is organised by the Center Synergy of Systems (SynoSys), TU Dresden, 01062 Dresden, Germany.
  </p>
</PageLayout>
