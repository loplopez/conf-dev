---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
import { contributions } from '../../data/conference';

// Structure, topics and rules adopted from netsci2026.com/call-for-abstracts (decided 6 Oct 2026);
// lightning talks dropped for 2027; topics and AI rule from the program chairs (6 Oct 2026);
// Community Detection and Multi-Agent and LLM Networks added 8 Oct 2026.
const topics = [
  'Adaptive Networks',
  'Biological Networks',
  'Brain Networks',
  'Community Detection',
  'Critical Phenomena In Networks',
  'Cultural And Historical Network Analysis',
  'Dynamics On Networks',
  'Ecological Networks',
  'Ethics And Fairness In Network Analysis',
  'Financial Networks',
  'Graph Machine Learning',
  'Higher-Order Networks',
  'Linguistic Networks',
  'Mobility Networks',
  'Models Of Networks',
  'Multi-Agent and LLM Networks',
  'Multilayer Networks',
  'Network Control',
  'Network Data Collection',
  'Network Epidemiology',
  'Network Geometry',
  'Network Measures And Metrics',
  'Network Resilience',
  'Network Science and Education',
  'Network Visualization',
  'Signed Networks',
  'Social Networks',
  'Spatial Networks',
  'Statistical Analysis Of Networks And Inference',
  'Synchronization and control',
  'Technological Networks',
  'Temporal Networks',
];
const SUBMIT_URL = 'https://netsci2027.eventclass.it/';
const TEMPLATE_URL = 'https://www.overleaf.com/latex/templates/netsci2027-abstract-template/gqryjjnvrczn';
---

<PageLayout
  title="Call for Abstracts"
  eyebrow="Calls"
  lede="Submit your work on any topic in network science as a one-page abstract. Deadline: 1 December 2026."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Calls' }, { label: 'Abstracts' }]}
>
  <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10">
    <Prose>
      <h2>Submissions</h2>
      <p>
        We invite one-page abstracts across all areas of network science, and especially work that
        breaks the field's current boundaries. Each abstract includes one mandatory descriptive
        figure (with caption) and references. Abstracts are reviewed by the Program Committee and
        accepted as a contributed talk or a poster. Authors may indicate a preferred format; the
        Program Committee makes the final decision.
      </p>

      <h2>Abstract requirements</h2>
      <ul>
        <li>Abstracts must be no longer than one page, including text, figure, and references.</li>
        <li>Submissions must be in PDF format, prepared with the official LaTeX template.</li>
        <li>The language of submission and presentation is English.</li>
        <li>Each accepted abstract must be presented in person by one of its authors.</li>
        <li>Each author may present only one abstract at the main conference.</li>
        <li>Presenting authors must register by the presenter deadline to appear in the final program.</li>
        <li><strong>Use of generative AI:</strong> Authors are fully responsible for the accuracy, originality, and scholarly quality of their abstracts; generative AI may assist with language and editing, but not replace the authors' own scientific contribution. Irresponsible use of generative AI for fabricating content (such as invented results, figures, or references) will not be accepted: such submissions will be desk rejected, and repeated occurrence will be recorded.</li>
      </ul>

      <h2>Conference topics</h2>
      <p>Topics include, but are not limited to:</p>
      <ul>
        {topics.map((t) => <li>{t}</li>)}
      </ul>

      <h2>Presentation formats</h2>
      <ul>
        {contributions.map((c) => (
          <li><strong>{c.title}</strong> ({c.spec}): {c.desc}</li>
        ))}
      </ul>

      <h2>How to submit</h2>
      <ol>
        <li>
          Prepare your abstract with the official
          <a href={TEMPLATE_URL} target="_blank" rel="noopener">NetSci 2027 LaTeX template on Overleaf</a>.
        </li>
        <li>
          Submit the PDF through the
          <a href={SUBMIT_URL} target="_blank" rel="noopener">NetSci 2027 submission system</a>.
        </li>
      </ol>

      <h2>Questions</h2>
      <p>
        Write to <a href="mailto:program.netsci@tu-dresden.de">program.netsci@tu-dresden.de</a>.
      </p>
    </Prose>

    <aside class="space-y-6 h-fit">
      <div data-reveal class="bg-[#EEEEFF] text-[#171717] p-7">
        <h2 class="font-display text-lg font-bold">Submit your abstract</h2>
        <p class="mt-2 text-sm text-[#242A2F]">Deadline: 1 December 2026</p>
        <a
          href={SUBMIT_URL}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-block bg-[#00008C] text-white font-medium px-5 py-2.5 hover:opacity-90"
        >Go to submission system</a>
        <a
          href={TEMPLATE_URL}
          target="_blank"
          rel="noopener"
          class="mt-3 block text-sm text-[#242A2F] underline hover:text-[#2F6DB5]"
        >Download the LaTeX template</a>
      </div>
      <div data-reveal class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7">
        <h2 class="font-display text-lg font-bold text-tu-deep">Key dates</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex justify-between gap-3"><span>Submission deadline</span><span class="font-mono text-tu-ink/70">1 Dec 2026</span></li>
          <li class="flex justify-between gap-3"><span>Notification of acceptance</span><span class="font-mono text-tu-ink/70">TBD</span></li>
          <li class="flex justify-between gap-3"><span>Early bird registration</span><span class="font-mono text-tu-ink/70">28 Feb 2027</span></li>
          <li class="flex justify-between gap-3"><span>Satellites &amp; School</span><span class="font-mono text-tu-ink/70">17–18 May 2027</span></li>
          <li class="flex justify-between gap-3"><span>Main conference</span><span class="font-mono text-tu-ink/70">18–21 May 2027</span></li>
        </ul>
      </div>
    </aside>
  </div>
</PageLayout>
