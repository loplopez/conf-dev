---
import PageLayout from '../../layouts/PageLayout.astro';
import { dates } from '../../data/conference';

const calls = [
  {
    href: '/calls/abstracts',
    title: 'Call for Abstracts',
    desc: 'Submit a one-page abstract for a contributed talk, lightning talk, or poster.',
    deadline: '15 December 2026',
  },
  {
    href: '/calls/satellites',
    title: 'Call for Satellites',
    desc: 'Propose a half- or full-day satellite symposium on a focused topic.',
    deadline: '15 November 2026',
  },
];
---

<PageLayout
  title="Calls"
  eyebrow="Submissions"
  lede="NetSci 2027 invites abstracts and satellite proposals from across network science."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Calls' }]}
>
  <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10">
    <div class="grid gap-6">
      {calls.map((c) => (
        <a
          href={c.href}
          data-reveal
          class="block bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 hover:border-tu-blue transition-colors"
        >
          <h2 class="font-display text-2xl font-bold text-tu-deep">{c.title}</h2>
          <p class="mt-2 text-tu-ink/70">{c.desc}</p>
          <p class="mt-4 text-sm font-mono text-tu-blue">Deadline: {c.deadline}</p>
        </a>
      ))}
    </div>

    <aside data-reveal class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 h-fit">
      <h2 class="font-display text-lg font-bold text-tu-deep">Key dates</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {dates.map((d) => (
          <li class="flex justify-between gap-3">
            <span class:list={[d.done ? 'line-through text-tu-ink/40' : 'text-tu-ink']}>{d.label}</span>
            <span class:list={['font-mono shrink-0', d.done ? 'line-through text-tu-ink/40' : 'text-tu-ink/70']}>{d.date}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</PageLayout>
