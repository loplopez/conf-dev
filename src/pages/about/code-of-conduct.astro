---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Code of Conduct"
  eyebrow="About"
  lede="NetSci 2027 is committed to a safe, respectful, and inclusive environment for everyone."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about' }, { label: 'Code of Conduct' }]}
>
  <Prose>
    <p>
      All participants, speakers, organisers, and partners are expected to follow this code of
      conduct at all conference events, including satellites and social activities.
    </p>
    <h2>Our standards</h2>
    <ul>
      <li>Treat everyone with respect, regardless of background, identity, or seniority.</li>
      <li>Engage in constructive, good-faith scientific discussion.</li>
      <li>Respect personal boundaries and obtain consent before photographing others.</li>
    </ul>
    <h2>Unacceptable behaviour</h2>
    <ul>
      <li>Harassment, intimidation, or discrimination in any form.</li>
      <li>Disruptive or threatening conduct during sessions or social events.</li>
      <li>Unwelcome sexual attention or advances.</li>
    </ul>
    <h2>Reporting</h2>
    <p>
      If you experience or witness a violation, contact a member of the organising team or email
      <a href="mailto:netsci@tu-dresden.de">netsci@tu-dresden.de</a>. Reports are handled
      confidentially. Organisers may take any action they deem appropriate, up to removal from the
      conference without refund.
    </p>
  </Prose>
</PageLayout>
