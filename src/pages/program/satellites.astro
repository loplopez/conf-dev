---
import { u } from '../../lib/url';
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const satellites = (await getCollection('satellites')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<PageLayout
  title="Satellite Symposia"
  eyebrow="Program"
  lede="Focused, community-organised meetings held on the days framing the main conference."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Program' },
    { label: 'Satellites' },
  ]}
>
  {satellites.length === 0 && (
    <div data-reveal class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-8 text-tu-ink/80">
      <p>
        Coming up soon. Accepted satellites will be announced here.
        Want to organise one? See the <a href={u('/calls/satellites')} class="text-tu-blue underline">Call for Satellites</a>.
      </p>
    </div>
  )}
  <div class="space-y-5">
    {satellites.map((sat) => (
      <article
        data-reveal
        class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 grid md:grid-cols-[1fr_auto] gap-4 items-start"
      >
        <div>
          <h2 class="font-display text-2xl font-bold text-tu-deep">{sat.data.title}</h2>
          <p class="mt-1 text-tu-ink/70">{sat.data.topic}</p>
          <p class="mt-3 text-sm text-tu-ink/60">
            Organised by <strong class="text-tu-deep font-medium">{sat.data.organizers.join(', ')}</strong>
          </p>
        </div>
        <div class="text-sm font-mono text-tu-blue md:text-right whitespace-nowrap">
          <div>{sat.data.date}</div>
          <div class="text-tu-ink/50">{sat.data.room}</div>
        </div>
      </article>
    ))}
  </div>
</PageLayout>
