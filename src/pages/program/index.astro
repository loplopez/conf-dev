---
import PageLayout from '../../layouts/PageLayout.astro';

const sections = [
  { href: '/program/speakers', title: 'Speakers', desc: 'Keynote and Breaking Boundaries talks.' },
  { href: '/program/schedule', title: 'Schedule', desc: 'Day-by-day overview of the five-day program.' },
  { href: '/program/satellites', title: 'Satellites', desc: 'Community-organised focused symposia.' },
  { href: '/program/posters', title: 'Posters', desc: 'Two poster sessions and presentation guidelines.' },
  { href: '/program/social', title: 'Social Program', desc: 'Reception, excursion, and conference dinner.' },
];
---

<PageLayout
  title="Program"
  eyebrow="NetSci 2027"
  lede="Keynotes, contributed talks, posters, satellites, and a social program — in Dresden."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Program' }]}
>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {sections.map((s) => (
      <a
        href={s.href}
        data-reveal
        class="group bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 hover:shadow-soft hover:-translate-y-1 transition-all duration-300"
      >
        <h2 class="font-display text-xl font-bold text-tu-deep group-hover:text-tu-navy">{s.title}</h2>
        <p class="mt-2 text-sm text-tu-ink/70">{s.desc}</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-tu-navy">
          View
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </span>
      </a>
    ))}
  </div>
</PageLayout>
