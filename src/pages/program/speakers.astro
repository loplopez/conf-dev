---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { u } from '../../lib/url';

const all = (await getCollection('speakers')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  // Breaking Boundaries first (8 Oct 2026).
  {
    title: 'Breaking Boundaries',
    speakers: all.filter((s) => s.data.category === 'Breaking Boundaries'),
  },
  {
    title: 'Keynote Speakers',
    speakers: all.filter((s) => s.data.category === 'Keynote'),
  },
].filter((g) => g.speakers.length > 0);
---

<PageLayout
  title="Speakers"
  eyebrow="Program"
  lede="Breaking Boundaries and keynote speakers at NetSci 2027. More speakers will be announced soon."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Program' },
    { label: 'Speakers' },
  ]}
>
  <div class="space-y-14">
    {groups.map((g) => (
      <section>
        <h2 class="text-3xl mb-6">{g.title}</h2>
        <div class="space-y-5">
          {g.speakers.map((s) => (
            <article class="shadow-card p-6 md:p-8 flex flex-col sm:flex-row gap-6 items-start">
              {s.data.photo ? (
                <img
                  src={u(s.data.photo)}
                  alt={s.data.name}
                  class="w-32 h-32 rounded-full object-cover shrink-0"
                  loading="lazy"
                />
              ) : (
                <div
                  class="w-32 h-32 rounded-full bg-[#00008C] text-white text-4xl font-light flex items-center justify-center shrink-0"
                  aria-label={`${s.data.name} (photo coming soon)`}
                >
                  {s.data.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                </div>
              )}
              <div class="min-w-0">
                <h3 class="text-2xl leading-tight">{s.data.name}</h3>
                <p class="text-[#66668F]">{s.data.affiliation}</p>
                {s.data.talkTitle && <p class="mt-2 font-medium text-[#171717]">“{s.data.talkTitle}”</p>}
                {s.body.trim()
                  ? <div class="mt-3 text-[15px] leading-relaxed text-[#171717]" set:html={s.body} />
                  : <p class="mt-3 text-[15px] text-[#66668F] italic">Bio coming soon.</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</PageLayout>
