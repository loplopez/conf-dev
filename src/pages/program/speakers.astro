---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const all = (await getCollection('speakers')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  {
    title: 'Keynote Speakers',
    speakers: all.filter((s) => s.data.category === 'Keynote'),
  },
  {
    title: 'Breaking Boundaries',
    speakers: all.filter((s) => s.data.category === 'Breaking Boundaries'),
  },
].filter((g) => g.speakers.length > 0);
---

<PageLayout
  title="Speakers"
  eyebrow="Program"
  lede="Keynote and Breaking Boundaries speakers at NetSci 2027. More speakers will be announced soon."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Program', href: '/program' },
    { label: 'Speakers' },
  ]}
>
  <div class="space-y-14">
    {groups.map((g) => (
      <section>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-tu-deep mb-6">{g.title}</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {g.speakers.map((s) => (
            <article
              data-reveal
              class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 flex flex-col"
            >
              <div class="flex items-start gap-4">
                {s.data.photo ? (
                  <img
                    src={s.data.photo}
                    alt={s.data.name}
                    class="w-16 h-16 rounded-full object-cover shrink-0"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-16 h-16 rounded-full bg-tu-navy text-white font-display text-xl font-bold flex items-center justify-center shrink-0">
                    {s.data.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                  </div>
                )}
                <div>
                  <h3 class="font-display text-xl font-bold text-tu-deep leading-tight">{s.data.name}</h3>
                  <p class="text-sm text-tu-ink/70">{s.data.affiliation}</p>
                </div>
              </div>
              {s.data.field && (
                <div class="mt-4 text-xs uppercase tracking-[0.2em] text-tu-blue font-semibold">{s.data.field}</div>
              )}
              {s.data.talkTitle && <p class="mt-1 font-medium text-tu-deep">“{s.data.talkTitle}”</p>}
              {s.body.trim() && <div class="mt-3 text-sm text-tu-ink/70 leading-relaxed" set:html={s.body} />}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</PageLayout>
