---
// Minimal landing per CTO request: hero only. No About/Dates/Contributions/Discover/Footer
// until content is finalized. The other components remain in the repo and can be re-enabled
// by importing them and adding them back to <main>.
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.tsx';
import Footer from '../components/layout/Footer.tsx';
import Hero from '../components/sections/Hero.tsx';
import heroPhoto from '../assets/dresden-silhouette.jpg';

const heroImg = await getImage({ src: heroPhoto, widths: [640, 1024, 1536, 1920], format: 'avif' });
const hero = { src: heroImg.src, srcSet: heroImg.srcSet.attribute };
---

<Layout title="NetSci Dresden 2027 — International Conference on Network Science">
  <Navbar client:load />
  <main>
    <Hero image={hero} />
  </main>
  <Footer minimal />
</Layout>
