---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Venue"
  eyebrow="Venue & Travel"
  lede="NetSci 2027 takes place at a to-be-revealed location in Dresden."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Venue & Travel', href: '/venue' }, { label: 'Venue' }]}
>
  <Prose>
    <p>
      The conference venue will be announced soon. Satellites and the school run on 17–18 May 2027,
      followed by the main conference from 18 to 21 May 2027.
    </p>
    <p>
      Questions in the meantime? Write to <a href="mailto:netsci@tu-dresden.de">netsci@tu-dresden.de</a>.
    </p>
  </Prose>
</PageLayout>
