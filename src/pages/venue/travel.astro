---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Getting to Dresden"
  lede="Dresden is well connected by air and rail across central Europe."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Venue & Travel' }, { label: 'Getting to Dresden' }]}
>
  <Prose>
    <h2>By air</h2>
    <ul>
      <li><strong>Dresden (DRS)</strong>: the closest airport, about 20 minutes to the city centre by S-Bahn.</li>
      <li><strong>Berlin (BER)</strong>: about 2 to 2.5 hours to Dresden by train.</li>
      <li><strong>Prague (PRG)</strong>: about 2.5 hours by train or bus along the Elbe valley.</li>
      <li><strong>Leipzig/Halle (LEJ)</strong>: about 1.5 hours by train.</li>
    </ul>
    <h2>By rail</h2>
    <p>
      Dresden Hauptbahnhof and Dresden-Neustadt are served by frequent long-distance trains, including
      direct connections to Berlin, Leipzig, Frankfurt, and Prague.
    </p>
    <h2>Getting around</h2>
    <p>
      Dresden's trams and buses (DVB) cover the city. Directions to the venue will be added once the
      location is announced.
    </p>
  </Prose>
</PageLayout>
