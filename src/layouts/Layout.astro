---
import { u } from '../lib/url';
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

const lang = 'en';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'International School and Conference on Network Science · 17–21 May 2027 · Dresden, Germany. Calls for abstracts and satellites are open.',
  image = '/og-image.jpg',
} = Astro.props;

const site = Astro.site ?? new URL('https://netsci2027.github.io');
const canonicalURL = new URL(Astro.url.pathname, site);
const siteOrigin = site.origin;
// Absolute URL (with the base path) so link previews on LinkedIn, Slack, X etc. find the image.
const imageURL = new URL(u(image), siteOrigin).href;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'NetSci Dresden 2027 — International School and Conference on Network Science',
  description,
  startDate: '2027-05-17',
  endDate: '2027-05-21',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  url: new URL(u('/'), siteOrigin).href,
  image: imageURL,
  location: {
    '@type': 'Place',
    name: 'Dresden (venue to be announced)',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dresden',
      addressCountry: 'DE',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Network Science Society',
    url: 'https://netscisociety.net',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts: preconnect + non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Zilla+Slab:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fira+Sans+Condensed:wght@500;600;700&family=Rubik:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={imageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content="NetSci 2027 · International School & Conference on Network Science · May 17–21, 2027 · Dresden, Germany" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={imageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <meta name="theme-color" content="#00005C" />

    <!-- Structured data for rich conference results -->
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} is:inline />

    <!-- SPA-style page transitions -->
    <ViewTransitions />
  </head>
  <body>
    <slot />

    <script>
      // Scroll-reveal via IntersectionObserver. Runs on first load and after each
      // view transition (astro:page-load fires on both).
      function initReveal() {
        const els = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
      initReveal();

      // Landing-only demo: stop dead links (href="#") from jumping to the top.
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const dead = target?.closest?.('a[href="#"]');
        if (dead) e.preventDefault();
      });
    </script>
    <script>
    import '../scripts/networks.ts';
  </script>
  </body>
</html>
